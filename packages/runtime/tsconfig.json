{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["loader/**/*.ts", "models/**/*.ts", "api/**/*.ts", "errors/**/*.ts", "tests/**/*.ts", "index.ts"]
}
